@page
@model GastroStock.Pages.InventarioModel
@{
    ViewData["Title"] = "Panel de Inventario - GastroStock";
}

<div class="container-fluid px-4 py-4" style="background-color: #f8f9fa; min-height: 90vh;">
    
    <!-- Encabezado Principal -->
    <div class="row align-items-center mb-4 bg-white p-3 shadow-sm" style="border-radius: 12px; border-left: 6px solid #0d6efd;">
        <div class="col-md-8">
            <h1 class="text-dark font-weight-bold m-0" style="font-size: 28px;">📋 Panel de Control de Inventario</h1>
            <p class="text-muted m-0 mt-1">Monitoreo analítico de existencias y alertas de mermas en tiempo real.</p>
        </div>
        <div class="col-md-4 text-md-end mt-2 mt-md-0">
            <span class="badge bg-light text-dark p-2 border">
                📅 Hoy: @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    <!-- TARJETAS DE INDICADORES (KPIs) SUPERIORES -->
    <div class="row mb-4 g-3">
        <!-- Tarjeta 1: Total de Insumos -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1 font-weight-bold" style="font-size: 12px; letter-spacing: 1px;">Total Insumos</h6>
                        <h2 class="m-0 font-weight-bold text-dark">@Model.ListaIngredientes.Count</h2>
                    </div>
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle" style="background-color: #e7f1ff;">
                        <span style="font-size: 24px;">📦</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Panel de Alertas Críticas -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px; border-bottom: 4px solid #dc3545;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-danger text-uppercase mb-1 font-weight-bold" style="font-size: 12px; letter-spacing: 1px;">Insumos en Riesgo</h6>
                        <h2 class="m-0 font-weight-bold text-danger">@Model.TotalAlertas</h2>
                    </div>
                    <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-circle" style="background-color: #f8d7da;">
                        <span style="font-size: 24px;">⚠️</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Estado Operativo -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between p-4">
                    <div>
                        <h6 class="text-muted text-uppercase mb-1 font-weight-bold" style="font-size: 12px; letter-spacing: 1px;">Estado del Sistema</h6>
                        <h5 class="m-0 font-weight-bold @(Model.TotalAlertas > 0 ? "text-warning" : "text-success")">
                            @(Model.TotalAlertas > 0 ? "⚠️ Requiere Atención" : "✔️ Operación Segura")
                        </h5>
                    </div>
                    <div class="p-3 rounded-circle" style="background-color: @(Model.TotalAlertas > 0 ? "#fff3cd" : "#d1e7dd");">
                        <span style="font-size: 24px;">@(Model.TotalAlertas > 0 ? "⚡" : "🛡️")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN DE ACCIONES CON ESTILO -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body d-flex justify-content-between align-items-center py-3 px-4">
            <h5 class="m-0 font-weight-bold text-secondary" style="font-size: 16px;">Acciones Operativas</h5>
            <div class="d-flex gap-2">
                <button class="btn btn-success font-weight-bold px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAgregar" style="border-radius: 8px;">
                    ➕ Agregar Nuevo Insumo
                </button>
                <form method="post" asp-page-handler="SimularVenta" style="display:inline;">
                    <button type="submit" class="btn btn-warning font-weight-bold text-white px-3 shadow-sm" style="border-radius: 8px;">
                        🔥 Simular Venta (Restar Stock)
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- TABLA DE INVENTARIO CON DISEÑO REFINADO -->
    <div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-dark py-3 px-4">
            <h5 class="m-0 text-white font-weight-bold" style="font-size: 16px;">📋 Lista de Existencias</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light text-uppercase fs-7 text-secondary" style="font-size: 12px; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3">Ingrediente</th>
                            <th class="py-3">Stock Actual</th>
                            <th class="py-3">Stock Mínimo</th>
                            <th class="py-3">Fecha de Caducidad</th>
                            <th class="py-3">Estado / Alerta</th>
                            <th class="pe-4 py-3 text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ListaIngredientes.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted p-5">
                                    <span style="font-size: 30px;">🔍</span><br />
                                    No hay ingredientes registrados en la base de datos.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.ListaIngredientes)
                        {
                            string claseFila = "";
                            string badgeEstado = "";

                            if (item.EstadoAlerta == "Por Vencer")
                            {
                                claseFila = "table-danger bg-opacity-10";
                                badgeEstado = "<span class='badge bg-danger px-3 py-2 rounded-pill shadow-sm'>🚨 Por Vencer</span>";
                            }
                            else if (item.EstadoAlerta == "Bajo Stock")
                            {
                                claseFila = "table-warning bg-opacity-10";
                                badgeEstado = "<span class='badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm'>⚠️ Stock Bajo</span>";
                            }
                            else
                            {
                                badgeEstado = "<span class='badge bg-success px-3 py-2 rounded-pill shadow-sm'>✔️ Óptimo</span>";
                            }

                            <tr class="@claseFila" style="transition: all 0.2s;">
                                <td class="ps-4"><strong>@item.Nombre</strong></td>
                                <td class="font-weight-bold">@item.StockActual.ToString("N2")</td>
                                <td class="text-muted">@item.StockMinimo.ToString("N2")</td>
                                <td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                <td>@Html.Raw(badgeEstado)</td>
                                <td class="pe-4 text-end">
                                    <button class="btn btn-sm btn-outline-primary px-3" style="border-radius: 6px;">Editar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- VENTANA EMERGENTE (MODAL) SIN CAMBIOS -->
<!-- ========================================== -->
<div class="modal fade" id="modalAgregar" tabindex="-1" aria-labelledby="modalAgregarLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-success text-white" style="border-top-left-radius: 14px; border-top-right-radius: 14px;">
                <h5 class="modal-title font-weight-bold" id="modalAgregarLabel">➕ Registrar Nuevo Insumo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="AgregarInsumo">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Nombre del Ingrediente</label>
                        <input type="text" class="form-control" name="nombre" placeholder="Ej. Queso Mozzarella (Kg)" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Stock Inicial</label>
                            <input type="number" step="0.01" class="form-control" name="stockActual" placeholder="0.00" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold">Stock Mínimo</label>
                            <input type="number" step="0.01" class="form-control" name="stockMinimo" placeholder="0.00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Fecha de Vencimiento</label>
                        <input type="date" class="form-control" name="fechaVencimiento" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success font-weight-bold">Guardar en Base de Datos</button>
                </div>
            </form> 
        </div>
    </div>
</div>
