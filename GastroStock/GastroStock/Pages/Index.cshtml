@page
@model IndexModel
@{
    ViewData["Title"] = "Iniciar Sesión - GastroStock";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 400px; border-radius: 15px;">
        <div class="text-center mb-4">
            <h2 class="text-primary font-weight-bold">GastroStock</h2>
            <p class="text-muted">Control de Inventario Gastronómico</p>
        </div>

        
        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-danger text-center p-2 small mb-3" style="border-radius: 8px;">
                @Model.MensajeError
            </div>
        }

        <form method="post">
            <div class="form-group mb-3">
                <label class="form-label font-weight-bold">Usuario</label>
                
                <input type="text" class="form-control" placeholder="Ej. admin_restaurante" required name="usuario" />
            </div>

            <div class="form-group mb-4">
                <label class="form-label font-weight-bold">Contraseña</label>
                
                <input type="password" class="form-control" placeholder="••••••••" required name="contrasenia" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 font-weight-bold" style="border-radius: 8px;">
                Ingresar al Sistema
            </button>
        </form>
    </div>
</div>
